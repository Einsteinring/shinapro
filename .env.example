# ---------- База данных (SQLite через Prisma) ----------
DATABASE_URL="file:./dev.db"

# ---------- Публичный адрес сайта (метатеги, sitemap, Open Graph) ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Telegram-уведомления о заявках ----------
# 1. Создайте бота через @BotFather и вставьте токен.
# 2. Напишите боту любое сообщение и узнайте chat_id (например, через @userinfobot
#    или запросом GET https://api.telegram.org/bot<TOKEN>/getUpdates).
# Если переменные пустые, заявки просто сохраняются в БД, ошибок не будет.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Если api.telegram.org недоступен напрямую (работает только через VPN/прокси),
# укажите адрес локального прокси, например "http://127.0.0.1:10809". На сервере оставьте пустым.
TELEGRAM_PROXY=""

# ---------- Мини-админка /admin ----------
ADMIN_PASSWORD="change-me"
# Длинная случайная строка, подписывает cookie сессии. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-long-random-string"

# ---------- Антиспам ----------
# Максимум заявок с одного IP за окно (по умолчанию 5 за 10 минут)
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_MINUTES="10"
