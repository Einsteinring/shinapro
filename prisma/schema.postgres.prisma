// Схема для продакшена (Vercel + Neon/Postgres). Модель идентична schema.prisma:
// Prisma не умеет менять provider через env, поэтому файла два, а нужный выбирает
// scripts/prisma.mjs по префиксу DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Заявка на запись. Дата и время храним строками (YYYY-MM-DD, HH:mm),
/// чтобы не зависеть от часового пояса сервера: слоты привязаны к локальному времени филиала.
model Booking {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  car         String?
  branchId    String
  date        String
  /// HH:mm. null — визит без получасового слота: так приезжают сдавать шины на хранение.
  /// Частичный уникальный индекс (prisma/constraints.sql) считает NULL-значения разными,
  /// поэтому несколько сдач в один день не мешают друг другу.
  time        String?
  comment     String?
  /// Снимок расчёта из калькулятора (JSON-строка), если клиент пришёл из калькулятора.
  calculation String?
  /// Итоговая сумма расчёта для быстрых выборок в админке.
  calcTotal   Int?
  /// site | miniapp — откуда пришла заявка.
  source      String   @default("site")
  /// Id услуги из Mini App: у заявок с сайта пусто, там состав работ виден в расчёте.
  service     String?
  /// Telegram id клиента из проверенного initData. Только по нему человек видит
  /// и отменяет свои записи; в теле запросов этот id не принимается.
  telegramId  String?
  /// new | confirmed | done | cancelled
  status      String   @default("new")
  ip          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, date, status])
  @@index([status, createdAt])
  @@index([telegramId, date])
}
