# ---------- База данных (Prisma) ----------
# Локально: SQLite, ноль настройки. На Vercel: строка Neon/Postgres вида
# postgresql://user:password@host/db?sslmode=require — схема выбирается автоматически по префиксу.
DATABASE_URL="file:./dev.db"

# ---------- Публичный адрес сайта (метатеги, sitemap, Open Graph) ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Telegram Mini App ----------
# Заявки и с сайта, и из Mini App складываются в одну таблицу и разбираются в /admin,
# уведомлений в Telegram нет. Бот нужен для другого: он открывает приложение по /start,
# и его же токеном проверяется подпись initData — без токена Mini App не пустит никого.
#
# 1. Создайте бота через @BotFather и вставьте токен.
# 2. После деплоя: node scripts/set-webhook.mjs
# 3. В @BotFather: /setmenubutton → адрес вида https://ваш-домен/app
TELEGRAM_BOT_TOKEN=""

# Произвольная длинная строка. Telegram присылает её в заголовке
# X-Telegram-Bot-Api-Secret-Token, а /api/bot сверяет и отбрасывает чужие запросы.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=""
# Если api.telegram.org недоступен напрямую (работает только через VPN/прокси),
# укажите адрес локального прокси, например "http://127.0.0.1:10809". На сервере оставьте пустым.
TELEGRAM_PROXY=""

# ---------- Мини-админка /admin ----------
ADMIN_PASSWORD="change-me"
# Длинная случайная строка, подписывает cookie сессии. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-long-random-string"

# ---------- Антиспам ----------
# Максимум заявок с одного IP за окно (по умолчанию 5 за 10 минут)
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_MINUTES="10"
